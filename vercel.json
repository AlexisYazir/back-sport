{
  "version": 2,
  "ignoreCommand": "node scripts/vercel-ignore-build.cjs",
  "git": {
    "deploymentEnabled": {
      "feature/moderacion-resenas-backend": false
    }
  },
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ]
}
